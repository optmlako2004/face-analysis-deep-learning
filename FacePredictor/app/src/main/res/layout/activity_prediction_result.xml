<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        app:title="@string/prediction_results"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">

            <!-- Image Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp"
                android:layout_marginBottom="@dimen/margin_large">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_image_size">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/prediction_results" />

                    <!-- Face detected badge -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFaceDetected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/margin_small"
                        android:text="Visage détecté"
                        android:textColor="@color/text_on_primary"
                        app:chipBackgroundColor="@color/success"
                        app:chipIcon="@drawable/ic_face"
                        app:chipIconTint="@color/text_on_primary"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- No Face Error Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoFace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardBackgroundColor="@color/error_light"
                app:strokeWidth="1dp"
                app:strokeColor="@color/error"
                android:layout_marginBottom="@dimen/margin_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_medium"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_xlarge"
                        android:layout_height="@dimen/icon_size_xlarge"
                        android:src="@drawable/ic_no_face"
                        app:tint="@color/error"
                        android:contentDescription="@string/no_face_detected" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_face_detected"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/error"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_face_message"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="@dimen/margin_tiny" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Results Container -->
            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Résultats de l'analyse"
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_medium" />

                <!-- Age Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardBackgroundColor="@color/age_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/age_card_border"
                    android:layout_marginBottom="@dimen/margin_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_medium"
                        android:gravity="center_vertical">

                        <!-- Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_age">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🎂"
                                android:textSize="20sp" />

                        </FrameLayout>

                        <!-- Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/margin_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/age"
                                android:textSize="@dimen/text_size_small"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_size_xlarge"
                                android:textColor="@color/age_card_border"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Confidence -->
                        <TextView
                            android:id="@+id/tvAgeConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:paddingVertical="@dimen/margin_tiny" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Gender Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardBackgroundColor="@color/gender_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gender_card_border"
                    android:layout_marginBottom="@dimen/margin_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_medium"
                        android:gravity="center_vertical">

                        <!-- Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_gender">

                            <TextView
                                android:id="@+id/tvGenderIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="👤"
                                android:textSize="20sp" />

                        </FrameLayout>

                        <!-- Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/margin_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/gender"
                                android:textSize="@dimen/text_size_small"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvGender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_size_xlarge"
                                android:textColor="@color/gender_card_border"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Confidence -->
                        <TextView
                            android:id="@+id/tvGenderConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:paddingVertical="@dimen/margin_tiny" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Ethnicity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardBackgroundColor="@color/ethnicity_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/ethnicity_card_border"
                    android:layout_marginBottom="@dimen/margin_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/margin_medium"
                        android:gravity="center_vertical">

                        <!-- Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_ethnicity">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🌍"
                                android:textSize="20sp" />

                        </FrameLayout>

                        <!-- Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/margin_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ethnicity"
                                android:textSize="@dimen/text_size_small"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvEthnicity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_size_xlarge"
                                android:textColor="@color/ethnicity_card_border"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Confidence -->
                        <TextView
                            android:id="@+id/tvEthnicityConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/chip_background"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:paddingVertical="@dimen/margin_tiny" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/save_prediction"
                    android:textSize="@dimen/text_size_body"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:backgroundTint="@color/primary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay_light"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/margin_xlarge">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/processing"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/margin_medium" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
