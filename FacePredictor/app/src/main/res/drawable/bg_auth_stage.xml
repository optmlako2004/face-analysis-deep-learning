<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
        </shape>
    </item>
    <item android:left="-40dp" android:top="-60dp">
        <shape android:shape="oval">
            <size android:width="240dp" android:height="240dp" />
            <solid android:color="#29C59B5B" />
        </shape>
    </item>
    <item android:right="-70dp" android:top="180dp">
        <shape android:shape="oval">
            <size android:width="220dp" android:height="220dp" />
            <solid android:color="#200F4C5C" />
        </shape>
    </item>
</layer-list>
